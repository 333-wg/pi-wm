{
	"appId": "com.wuming.desktop",
	"productName": "Pi-Wm",
	"publish": null,
	"compression": "maximum",
	"electronLanguages": ["en-US", "zh-CN", "zh-TW"],
	"directories": { "app": "apps/desktop", "output": "release" },
	"files": ["src/**/*", "resources/**/*", "package.json"],
	"extraResources": [
		{ "from": ".desktop-stage/runtime", "to": "runtime", "filter": ["**/*", "!node_modules{,/**/*}"] },
		{ "from": ".desktop-stage/runtime/node_modules", "to": "runtime/node_modules", "filter": ["**/*"] }
	],
	"afterPack": "scripts/verify-desktop-package.mjs",
	"asar": true,
	"npmRebuild": false,
	"mac": {
		"icon": "apps/web/src/assets/wuming-clover.png",
		"category": "public.app-category.developer-tools",
		"target": ["dmg", "zip"],
		"artifactName": "Pi-Wm-${version}-mac-${arch}.${ext}",
		"identity": "-",
		"hardenedRuntime": false,
		"notarize": false
	},
	"win": {
		"icon": "apps/desktop/resources/icon.ico",
		"target": [{ "target": "nsis", "arch": ["x64"] }],
		"executableName": "Pi-Wm",
		"artifactName": "Pi-Wm-${version}-Setup-${arch}.${ext}"
	},
	"nsis": {
		"include": "apps/desktop/installer/installer.nsh",
		"oneClick": false,
		"perMachine": false,
		"allowToChangeInstallationDirectory": true,
		"createDesktopShortcut": true,
		"createStartMenuShortcut": true,
		"deleteAppDataOnUninstall": false,
		"runAfterFinish": false
	}
}
