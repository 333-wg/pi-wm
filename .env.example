WUMING_HOST=127.0.0.1
WUMING_PORT=8787
WUMING_TOKEN=wuming
# `npm run local` sets local_device automatically. Without an explicit value the
# Gateway is treated as a server even on loopback, because a reverse proxy may expose it.
# local_device may bind only to loopback and is the only mode that may use the host Shell.
# WUMING_DEPLOYMENT_MODE=local_device
# Optional multi-principal static authentication. When set, each entry must
# include a unique token and id; role is owner, member, or viewer. Optional
# workspaceIds restricts that principal to selected workspace IDs.
# WUMING_AUTH_TOKENS_JSON=[{"token":"owner-token","id":"owner","role":"owner"},{"token":"viewer-token","id":"viewer","role":"viewer","workspaceIds":["docs"]}]
WUMING_RUNTIME=pi
WUMING_WORKSPACE=D:\path\to\workspace
# Optional: replaces WUMING_WORKSPACE with an explicit multi-workspace catalog.
# WUMING_WORKSPACES_JSON=[{"id":"app","name":"Application","path":"D:/code/app"},{"id":"docs","name":"Documentation","path":"D:/code/docs"}]
# Optional. Defaults to the current OS user's app-data directory:
# Windows %LOCALAPPDATA%\Wuming, macOS ~/Library/Application Support/Wuming,
# Linux ${XDG_DATA_HOME:-~/.local/share}/Wuming.
# WUMING_DATA_DIR=D:\path\to\wuming-data
# Limits for remote browser project imports. Local path-backed projects are not copied.
WUMING_PROJECT_MAX_FILES=10000
WUMING_PROJECT_MAX_BYTES=536870912
# Optional deployment-managed key. When omitted, the gateway creates
# WUMING_DATA_DIR/custom-models.key with restricted filesystem permissions.
# WUMING_MODEL_CONFIG_KEY=replace-with-a-long-random-secret
WUMING_TURN_TIMEOUT_MS=1200000
WUMING_ABORT_GRACE_MS=5000
WUMING_FORCE_TERMINATE_TIMEOUT_MS=2000
WUMING_MAX_RETRIES=2
WUMING_RETRY_BASE_DELAY_MS=1000
# Durable automation due-time scan interval. The minimum is 1000ms.
WUMING_AUTOMATION_POLL_MS=30000
# Optional per-session USD budget. Failed attempts still count toward the budget.
# WUMING_COST_BUDGET_USD=5
WUMING_MAX_ARTIFACT_BYTES=10485760
WUMING_MAX_VIDEO_ARTIFACT_BYTES=104857600
WUMING_MAX_TEXT_ARTIFACT_BYTES=2097152
WUMING_MAX_EXTRACTED_TEXT_CHARS=200000
WUMING_MAX_IMAGE_PIXELS=40000000
WUMING_MAX_TOOL_OUTPUT_CHARS=200000
WUMING_MAX_TOOL_ARTIFACT_BYTES=2097152
WUMING_MAX_DIRECTORY_ENTRIES=2000
WUMING_MAX_FILE_PREVIEW_BYTES=1048576
WUMING_MAX_GIT_OUTPUT_BYTES=2097152
WUMING_GIT_TIMEOUT_MS=10000
# Defaults to host in local_device mode and disabled in server mode.
# WUMING_TERMINAL_MODE=host
WUMING_TERMINAL_IDLE_TIMEOUT_MS=900000
WUMING_MAX_TERMINALS=8

# Optional. The browser's first-use setup can add an encrypted custom model
# without these values; use them for an existing Pi model catalog instead.
WUMING_AGENT_DIR=C:\path\to\.pi\agent
WUMING_MODEL_PROVIDER=anthropic
WUMING_MODEL_ID=your-model-id
WUMING_MODEL_NAME=Your model
# Whether the model above spends a thinking budget. Drives the composer's
# 思考强度 picker: false pins the session to "off" and disables the control.
# Defaults to true on the pi runtime and false on the demo runtime.
WUMING_MODEL_REASONING=true
WUMING_CONTEXT_WINDOW=200000
WUMING_MAX_OUTPUT_TOKENS=32000
# Pi threshold/overflow compaction is enabled by default. Set false only when
# another deployment layer owns conversation compaction.
WUMING_PI_AUTO_COMPACTION=true
# Context assembly reads only AGENTS.md, .wuming/context.md, and README.md.
WUMING_CONTEXT_FILE_MAX_LINES=2000
WUMING_CONTEXT_OUTPUT_RESERVE=32000
WUMING_MAX_SYSTEM_CONTEXT_TOKENS=32768
# Optional: replaces the single model above with the browser model catalog.
# WUMING_MODELS_JSON=[{"provider":"anthropic","id":"model-a","name":"Model A","reasoning":true,"input":["text","image"],"contextWindow":200000,"maxOutputTokens":32000,"authenticated":true}]

# Process tools use the user's environment only when this Gateway runs as the
# loopback local-device host. Server mode defaults to disabled and rejects local.
# Set docker only when the operator explicitly wants a server-side container.
# WUMING_PROCESS_MODE=local
# Set disabled to hide exec and run_python entirely.
# WUMING_PYTHON_EXECUTABLE=python
# WUMING_PROCESS_TIMEOUT_MS=300000
# WUMING_PROCESS_MAX_TIMEOUT_MS=1800000
# WUMING_PROCESS_MAX_OUTPUT_BYTES=1048576
# Environment discovery reads executable versions and project markers only.
# It never reads .env values or credentials.
WUMING_ENVIRONMENT_CACHE_TTL_MS=15000
# Optional Docker backend. Digest pinning is required by default.
WUMING_DOCKER_IMAGE=your-registry/wuming-runner@sha256:replace-with-image-digest
# Development escape hatch only; do not enable in production.
WUMING_DOCKER_ALLOW_MUTABLE_IMAGE=false
# Container limits. The defaults suit a real `npm ci`; raise them for heavier
# toolchains, lower them when the host is shared.
WUMING_DOCKER_CPUS=2
WUMING_DOCKER_MEMORY=2g
WUMING_DOCKER_PIDS_LIMIT=512
WUMING_DOCKER_TMPFS_SIZE=512m
WUMING_DOCKER_HOME_SIZE=512m
WUMING_DOCKER_TIMEOUT_MS=300000
WUMING_DOCKER_MAX_TIMEOUT_MS=1800000
WUMING_DOCKER_MAX_OUTPUT_BYTES=1048576
# The container is offline by default: a build that reaches the network can
# exfiltrate the workspace. Set bridge only when dependency installation is
# required, and only for workspaces whose contents may leave the host.
WUMING_DOCKER_NETWORK=none
# host networking removes the boundary entirely and needs this second opt-in.
WUMING_DOCKER_ALLOW_HOST_NETWORK=false
# Optional: a Docker volume mounted at HOME so package caches survive between
# commands. Without it HOME is a per-command tmpfs and every install is cold.
# WUMING_DOCKER_CACHE_VOLUME=wuming-agent-cache
# WUMING_DOCKER_HOME=/home/agent
# Optional. Defaults to the gateway's own uid:gid on POSIX so files the model
# creates in the workspace stay editable on the host.
# WUMING_DOCKER_USER=1000:1000

# Public web fetch is enabled in Pi mode with SSRF protection and these limits.
WUMING_WEB_TIMEOUT_MS=20000
WUMING_WEB_MAX_RESPONSE_BYTES=2097152
# HTTPS transparent-proxy DNS in 198.18.0.0/15 is verified by TLS automatically.
# Set true only when plain HTTP must use such a deployment-controlled proxy.
WUMING_WEB_ALLOW_PROXY_DNS=false
# web_search works without configuration through Bing HTML. Optional replacements:
# WUMING_WEB_SEARCH_PROVIDER=brave
# WUMING_WEB_SEARCH_API_KEY=replace-with-brave-search-key
# Optional Brave API override; required when provider=searxng.
# WUMING_WEB_SEARCH_ENDPOINT=https://search.example.com/search

# User-device Chromium for web research, downloads, and local UI verification.
# Each agent session gets an isolated context; the Gateway never reads the user's
# existing Chrome profile or cookies. This is available only in local_device mode.
WUMING_BROWSER_ENABLED=true
WUMING_BROWSER_HEADLESS=true
WUMING_BROWSER_TIMEOUT_MS=20000
WUMING_BROWSER_IDLE_TIMEOUT_MS=900000
WUMING_BROWSER_MAX_SESSIONS=8
WUMING_BROWSER_MAX_SNAPSHOT_CHARS=60000
WUMING_BROWSER_MAX_DOWNLOAD_BYTES=67108864
WUMING_BROWSER_MAX_SCREENSHOT_BYTES=8388608
# Optional system Chrome/Edge channel or absolute Chromium executable.
# WUMING_BROWSER_CHANNEL=chrome
# WUMING_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional public search page used by browser_search; it is opened by the local browser.
# WUMING_BROWSER_SEARCH_ENDPOINT=https://www.bing.com/search

# Local-device MCP configuration lives in each workspace's .wuming/mcp.json;
# user approvals are stored in .wuming/mcp-permissions.json and are invalidated
# when a server configuration changes. This deployment allowlist is optional and
# intended only for managed single-tenant hosts that intentionally pre-trust MCP.
# WUMING_MCP_TRUSTED_SERVERS_JSON=[{"workspaceId":"local-workspace","serverId":"docs"}]

# Agent-controlled local preview server. Defaults to true in local_device mode
# and false in server mode. Server mode rejects host preview explicitly.
# WUMING_PREVIEW_ENABLED=true
WUMING_PREVIEW_READY_TIMEOUT_MS=30000
WUMING_PREVIEW_IDLE_TIMEOUT_MS=1800000
WUMING_PREVIEW_MAX_OUTPUT_BYTES=262144
