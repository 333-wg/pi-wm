WUMING_HOST=127.0.0.1
WUMING_PORT=8787
WUMING_TOKEN=replace-with-a-long-random-token
WUMING_RUNTIME=demo
WUMING_WORKSPACE=D:\path\to\workspace
# Optional: replaces WUMING_WORKSPACE with an explicit multi-workspace catalog.
# WUMING_WORKSPACES_JSON=[{"id":"app","name":"Application","path":"D:/code/app"},{"id":"docs","name":"Documentation","path":"D:/code/docs"}]
WUMING_DATA_DIR=D:\path\to\wuming-data
# Optional deployment-managed key. When omitted, the gateway creates
# WUMING_DATA_DIR/custom-models.key with restricted filesystem permissions.
# WUMING_MODEL_CONFIG_KEY=replace-with-a-long-random-secret
WUMING_TURN_TIMEOUT_MS=1200000
WUMING_ABORT_GRACE_MS=5000
WUMING_FORCE_TERMINATE_TIMEOUT_MS=2000
WUMING_MAX_RETRIES=2
WUMING_RETRY_BASE_DELAY_MS=1000
# Optional per-session USD budget. Failed attempts still count toward the budget.
# WUMING_COST_BUDGET_USD=5
WUMING_MAX_ARTIFACT_BYTES=10485760
WUMING_MAX_TEXT_ARTIFACT_BYTES=2097152
WUMING_MAX_IMAGE_PIXELS=40000000
WUMING_MAX_TOOL_OUTPUT_CHARS=200000
WUMING_MAX_TOOL_ARTIFACT_BYTES=2097152
WUMING_MAX_DIRECTORY_ENTRIES=2000
WUMING_MAX_FILE_PREVIEW_BYTES=1048576
WUMING_MAX_GIT_OUTPUT_BYTES=2097152
WUMING_GIT_TIMEOUT_MS=10000
WUMING_TERMINAL_MODE=host
WUMING_TERMINAL_IDLE_TIMEOUT_MS=900000
WUMING_MAX_TERMINALS=8

# Required when WUMING_RUNTIME=pi
WUMING_AGENT_DIR=C:\path\to\.pi\agent
WUMING_MODEL_PROVIDER=anthropic
WUMING_MODEL_ID=your-model-id
WUMING_MODEL_NAME=Your model
WUMING_CONTEXT_WINDOW=200000
WUMING_MAX_OUTPUT_TOKENS=32000
# Optional: replaces the single model above with the browser model catalog.
# WUMING_MODELS_JSON=[{"provider":"anthropic","id":"model-a","name":"Model A","reasoning":true,"input":["text","image"],"contextWindow":200000,"maxOutputTokens":32000,"authenticated":true}]

# Optional: enables the Pi bash tool. Digest pinning is required by default.
WUMING_DOCKER_IMAGE=your-registry/wuming-runner@sha256:replace-with-image-digest
# Development escape hatch only; do not enable in production.
WUMING_DOCKER_ALLOW_MUTABLE_IMAGE=false

# Public web fetch is enabled in Pi mode with SSRF protection and these limits.
WUMING_WEB_TIMEOUT_MS=20000
WUMING_WEB_MAX_RESPONSE_BYTES=2097152
# HTTPS transparent-proxy DNS in 198.18.0.0/15 is verified by TLS automatically.
# Set true only when plain HTTP must use such a deployment-controlled proxy.
WUMING_WEB_ALLOW_PROXY_DNS=false
# web_search works without configuration through Bing HTML. Optional replacements:
# WUMING_WEB_SEARCH_PROVIDER=brave
# WUMING_WEB_SEARCH_API_KEY=replace-with-brave-search-key
# Optional Brave API override; required when provider=searxng.
# WUMING_WEB_SEARCH_ENDPOINT=https://search.example.com/search
